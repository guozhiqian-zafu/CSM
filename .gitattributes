# 统一换行符，避免 Windows/Linux 混合提交产生无意义的 diff
* text=auto

*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.pro     text eol=lf
*.gradle  text eol=lf
*.properties text eol=lf
gradlew   text eol=lf

*.bat     text eol=crlf
*.cmd     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.jar     binary
*.keystore binary
