<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/photo_thumb_size"
    android:layout_height="@dimen/photo_thumb_size">

    <ImageView
        android:id="@+id/iv_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_photo_1"
        android:contentDescription="@string/publish_photo_thumb"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/btn_remove"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_circle_dark"
        android:contentDescription="@string/publish_photo_remove"
        android:padding="5dp"
        android:src="@drawable/ic_close"
        app:tint="@android:color/white" />
</FrameLayout>
