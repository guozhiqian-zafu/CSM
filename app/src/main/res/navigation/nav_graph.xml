<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.csm.market.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_home_to_search"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.csm.market.ui.search.SearchFragment"
        android:label="@string/search_title"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_search_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.csm.market.ui.detail.DetailFragment"
        android:label="@string/detail_title"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="productId"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_detail_to_messages"
            app:destination="@id/messagesFragment" />
    </fragment>

    <fragment
        android:id="@+id/messagesFragment"
        android:name="com.csm.market.ui.messages.MessageFragment"
        android:label="@string/messages_title"
        tools:layout="@layout/fragment_messages">
        <argument
            android:name="productId"
            app:argType="string" />
        <argument
            android:name="productTitle"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/publishFragment"
        android:name="com.csm.market.ui.publish.PublishFragment"
        android:label="@string/publish_title"
        tools:layout="@layout/fragment_publish" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.csm.market.ui.favorites.FavoritesFragment"
        android:label="@string/favorites_title"
        tools:layout="@layout/fragment_favorites">
        <!-- 收藏页也能直接进详情：action 只对「声明它的页面」有效，所以这里单独声明一个 -->
        <action
            android:id="@+id/action_favorites_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.csm.market.ui.profile.ProfileFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_my_listings"
            app:destination="@id/myListingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/myListingsFragment"
        android:name="com.csm.market.ui.mylistings.MyListingsFragment"
        android:label="@string/my_listings_title"
        tools:layout="@layout/fragment_my_listings">
        <action
            android:id="@+id/action_my_listings_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>
</navigation>
